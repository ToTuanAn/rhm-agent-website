{
  "name": "rhm-agent-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Project page for RHM-Agent: Teaching VLMs to Reinforce Hierarchical Memory",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "frames": "node scripts/build-comparison-frames.mjs",
    "frames:results": "node scripts/build-results-frames.mjs",
    "clips": "node scripts/build-comparison-clips.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
